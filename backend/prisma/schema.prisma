// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// =============== ENUMS ===============
//

enum TransportMode {
  WALKING
  BIKE
  BIKE_SHARE
  SCOOTER
  SCOOTER_SHARE
  BUS
  TRAIN
  METRO
  CAR
  TAXI
  EV_CAR
}

enum StationType {
  GENERIC
  BUS_STOP
  TRAIN_STATION
  METRO_STATION
  BIKE_STATION
  SCOOTER_STATION
  CHARGING_STATION
}

enum VehicleType {
  ELECTRIC_BUS
  BIKE
  SCOOTER
  METRO
  TRAIN
  CAR
  TAXI
  EV_CAR
}

enum EnergyType {
  ELECTRIC
  HYBRID
  HUMAN_POWERED
  FOSSIL
}

enum RouteDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EcoPeriodType {
  DAY
  WEEK
  MONTH
  YEAR
}

enum ServiceAreaType {
  SCOOTER_ZONE
  BIKE_ZONE
  GENERIC
}

//
// =============== MODELS ===============
//

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  routes        Route[]
  preferences   UserPreferences?
  trips         RouteHistory[]
  searchHistory SearchHistory[]
  ecoStats      EcoStatsAggregate[]

  @@map("users")
}

model UserPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Transport preferences
  preferredTransportModes TransportMode[]  // ex: [WALKING, BIKE, BUS]
  maxWalkingDistance      Int      @default(500) // meters
  avoidHighways           Boolean  @default(false)
  ecoFriendlyOnly         Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

//
// Infra genérica: estações, veículos, linhas, áreas de serviço
//

model Station {
  id          String      @id @default(cuid())
  name        String
  description String?
  
  // Location data
  latitude    Float
  longitude   Float
  address     String?
  city        String?
  country     String?

  // Optional external reference (GTFS/API/etc.)
  externalId  String?     @unique

  // Station type and capabilities
  stationType StationType // BUS_STOP, BIKE_STATION, etc.
  isActive    Boolean     @default(true)

  // Capacity / availability (bike-share, scooters, docks, charging, etc.)
  capacity          Int?
  availableVehicles Int?
  availableDocks    Int?

  // Energy/sustainability info (para estações de carregamento, hubs, etc.)
  energySource    String? // "solar", "wind", "grid", ...
  carbonFootprint Float?  // kg CO2 per kWh
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  routes       RouteStation[]
  startRoutes  Route[]          @relation("RouteStartStation")
  endRoutes    Route[]          @relation("RouteEndStation")
  transitLines TransitLineStop[]
  vehicles     Vehicle[]

  @@map("stations")
}

model Vehicle {
  id          String       @id @default(cuid())
  name        String
  vehicleType VehicleType  // "ELECTRIC_BUS", "BIKE", etc.
  mode        TransportMode

  // Vehicle specs
  capacity    Int?         // passenger capacity

  energyType  EnergyType   // "ELECTRIC", "HYBRID", etc.
  batteryLevel Float?      // percentage (0-100)
  
  // Location
  currentLatitude  Float?
  currentLongitude Float?
  currentStationId String?
  currentStation   Station?  @relation(fields: [currentStationId], references: [id])
  isInService      Boolean   @default(true)
  
  // Sustainability metrics (fallback/local override de EmissionFactor)
  co2PerKm         Float? // kg CO2 per kilometer
  energyEfficiency Float? // kWh per km
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  routes RouteVehicle[]

  @@map("vehicles")
}

//
// Rotas base (entre estações) – podem representar linhas, percursos “template”, etc.
//

model Route {
  id          String  @id @default(cuid())
  name        String
  description String?
  
  // Route details (entre estações / pontos fixos)
  startStationId String
  endStationId   String
  startStation   Station @relation("RouteStartStation", fields: [startStationId], references: [id])
  endStation     Station @relation("RouteEndStation", fields: [endStationId], references: [id])
  
  // Transport modes desta rota
  mainMode       TransportMode
  modes          TransportMode[] // ex: [BUS], [BIKE], etc.
  
  // Route metrics
  distance      Float            // kilometers
  estimatedTime Int              // minutes
  difficulty    RouteDifficulty?
  
  // Sustainability metrics
  carbonFootprint  Float? // kg CO2 for entire route
  energyConsumption Float? // kWh for entire route
  ecoScore          Float? // 0-100 sustainability score
  
  // Geometry
  polyline   String? // encoded polyline
  geometry   Json?   // GeoJSON ou similar
  
  // Route status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId   String?
  user     User?          @relation(fields: [userId], references: [id])
  stations RouteStation[]
  vehicles RouteVehicle[]
  trips    RouteHistory[] // instâncias concretas usadas pelo utilizador

  @@map("routes")
}

model RouteStation {
  id        String  @id @default(cuid())
  routeId   String
  stationId String
  order     Int     // order of stations in the route
  
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id])

  @@unique([routeId, stationId])
  @@map("route_stations")
}

model RouteVehicle {
  id        String @id @default(cuid())
  routeId   String
  vehicleId String
  
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([routeId, vehicleId])
  @@map("route_vehicles")
}

//
// Linhas de transporte público (autocarro, comboio, metro) + paragens na linha
//

model TransitLine {
  id          String        @id @default(cuid())
  name        String
  code        String?       // ex: "708"
  description String?
  lineType    TransportMode // BUS, TRAIN, METRO, ...
  color       String?       // hex para UI (ex: "#FF6B6B")

  // Horários / frequências (pode ser GTFS simplificado ou um blob)
  schedule    Json?         // ex: { weekday: { headwayMinutes: 15, ... } }

  isActive    Boolean       @default(true)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stops       TransitLineStop[]

  @@map("transit_lines")
}

model TransitLineStop {
  id                   String       @id @default(cuid())
  transitLineId        String
  stationId            String
  order                Int          // ordem na linha
  distanceFromPrevMeters      Int?
  travelTimeFromPrevSeconds   Int?

  transitLine          TransitLine  @relation(fields: [transitLineId], references: [id], onDelete: Cascade)
  station              Station      @relation(fields: [stationId], references: [id])

  @@unique([transitLineId, stationId])
  @@index([stationId])
  @@map("transit_line_stops")
}

//
// Zonas de serviço (ex: áreas de trotinete-share)
//

model ServiceArea {
  id          String          @id @default(cuid())
  name        String
  description String?
  areaType    ServiceAreaType
  polygon     Json?           // GeoJSON polygon
  isActive    Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("service_areas")
}

//
// Histórico de pesquisas (ruas / POIs) – secção 5.2
//

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  query       String             // texto que o user escreveu
  placeId     String?            // id vindo da API (Mapbox, etc.)
  placeName   String             // nome formatado para mostrar depois
  latitude    Float?             // coords do resultado principal
  longitude   Float?
  raw         Json?              // payload bruto da API, se quiseres guardar

  searchedAt  DateTime @default(now())

  @@index([userId, searchedAt(sort: Desc)])
  @@map("search_history")
}

//
// Histórico de rotas do utilizador + segmentos – secção 5.1 + 3 + 4
//

model RouteHistory {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // opcional: ligação a uma Route "template" (linha, percurso sugerido, etc.)
  routeId String?
  route   Route? @relation(fields: [routeId], references: [id])

  // Origem & destino (texto + coords) – pode vir da SearchHistory
  originName             String
  originLatitude         Float
  originLongitude        Float
  destinationName        String
  destinationLatitude    Float
  destinationLongitude   Float

  // Modos usados nesta viagem
  primaryMode            TransportMode         // modo principal para UI
  modes                  TransportMode[]       // multimodal ex: [WALKING, BUS, WALKING]

  // Métricas agregadas
  distanceMeters         Int                   // total em metros
  durationSeconds        Int                   // total em segundos
  co2Kg                  Float                 // CO2 da viagem
  co2SavedVsCarKg        Float?                // CO2 poupado vs cenário carro

  // Estado da viagem / timeline
  status                 RouteStatus @default(PLANNED)
  startedAt              DateTime
  finishedAt             DateTime?

  // Geometria & segmentos
  polyline               String?    // polyline da rota completa
  segments               Json?      // array JSON com segmentos (tipo, distância, modo, etc.)
  metadata               Json?      // payload bruto da API de direções / debug

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([userId, startedAt(sort: Desc)])
  @@index([primaryMode])
  @@map("routes_history")
}

//
// Estatísticas ecológicas agregadas – secção 5.3 & 7
//

model EcoStatsAggregate {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ex: "2025-11-13" (day), "2025-11" (month), "2025" (year)
  period               String
  periodType           EcoPeriodType

  totalDistanceMeters  Int           @default(0)
  totalDurationSeconds Int           @default(0)
  totalCo2Kg           Float         @default(0)
  co2SavedVsCarKg      Float         @default(0)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([userId, period, periodType])
  @@map("eco_stats_aggregate")
}

//
// Fatores de emissão por modo – secção 6
//

model EmissionFactor {
  id         String        @id @default(cuid())
  mode       TransportMode @unique
  kgCo2PerKm Float         // fator base para cálculo: co2_kg = factor * (distance_km)
  notes      String?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("emission_factors")
}

//
// Sistemas GBFS (dados vindos do systems_PT.csv)
//

model GbfsSystem {
  id                    Int    @id @default(autoincrement())
  countryCode           String
  name                  String
  location              String?
  systemId              String @unique
  url                   String?
  autoDiscoveryUrl      String?
  supportedVersions     String?
  authenticationInfoUrl String?

  @@map("gbfs_systems")
}