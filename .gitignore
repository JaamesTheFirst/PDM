# ===========================================
# Sustainable Transport App - .gitignore
# ===========================================

# ===========================================
# Environment Variables & Secrets
# ===========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ===========================================
# Node.js / Backend (NestJS)
# ===========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Build outputs
dist/
build/
out/

# ===========================================
# Flutter / Mobile App
# ===========================================
