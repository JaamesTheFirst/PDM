# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sustainable_transport?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# API Configuration
PORT=3000
NODE_ENV=development

# Mapbox
MAPBOX_API_KEY="your-mapbox-access-token"

# External APIs
METRO_LISBOA_API_KEY="(optional legacy token)"
METRO_LISBOA_CLIENT_ID="your-metro-client-id"
METRO_LISBOA_CLIENT_SECRET="your-metro-client-secret"
GIRA_STATIONS_FILE="../EXTERNALS/data/gira/estacoes-gira-1-trimestre-2023.xlsx"
CP_VEHICLES_API_URL="https://comboios.live/api/vehicles"
CP_VEHICLES_CACHE_TTL_MS=30000
OTP_BASE_URL="http://localhost:8080/otp"
WATHER_API_KEY="your-weather-api-key"
TRANSPORT_API_KEY="your-transport-api-key"
